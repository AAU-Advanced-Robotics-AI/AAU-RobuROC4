<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_gps_pgo</name>
  <version>0.2.0</version>
  <description>
    GTSAM pose-graph optimization backend (C++) fusing FAST-LIO2 odometry,
    RTK GPS (fixed, plus float with an explicit drifting-bias model) and
    ScanContext loop closures.
  </description>
  <maintainer email="user@example.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>message_filters</depend>
  <depend>pcl_conversions</depend>
  <depend>ublox_msgs</depend>
  <depend>libpcl-all-dev</depend>
  <depend>eigen</depend>
  <depend>gtsam</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
