<?xml version="1.0"?>
<!--
  simulation.xacro - Gazebo Harmonic Simulation Configuration
  
  This file configures Gazebo-specific properties for the robot:
    - Friction coefficients (mu1, mu2) for physics simulation
    - Visual materials for Gazebo rendering
    - Joint state publisher plugin
    - Differential drive plugin (skid-steer configuration)
    
  Note: This file does NOT include sensor simulation - those are
  defined alongside their respective sensors in the sensors/ directory.
  
  Plugins:
    - gz-sim-joint-state-publisher-system: Publishes wheel joint states
    - gz-sim-diff-drive-system: Skid-steer drive controller
    
  Topics:
    - /joint_states: Wheel positions
    - /cmd_vel: Velocity commands (input)
    - /odom: Odometry (output)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ############################################## -->
    <!--              Link Friction/Materials          -->
    <!-- ############################################## -->
    
    <!-- Chassis: Low friction (slides if pushed) -->
    <gazebo reference="chassis_link">
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <visual>
            <material>
                <ambient>0.5 0.5 0.5 1</ambient>
                <diffuse>0.5 0.5 0.5 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
            </material>
        </visual>
    </gazebo>

    <!-- Wheels: High friction for traction -->
    <gazebo reference="wheel_1_link">
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
        <visual>
            <material>
                <ambient>0.1 0.1 0.1 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="wheel_2_link">
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
        <visual>
            <material>
                <ambient>0.1 0.1 0.1 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="wheel_3_link">
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
        <visual>
            <material>
                <ambient>0.1 0.1 0.1 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="wheel_4_link">
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
        <visual>
            <material>
                <ambient>0.1 0.1 0.1 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
            </material>
        </visual>
    </gazebo>

    <!-- IMU: Low friction, red visual -->
    <gazebo reference="IMU_link">
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <visual>
            <material>
                <ambient>0.8 0.0 0.0 1</ambient>
                <diffuse>0.8 0.0 0.0 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
            </material>
        </visual>
    </gazebo>

    <!-- ############################################## -->
    <!--              System Plugins                   -->
    <!-- ############################################## -->
    
    <!-- Joint State Publisher -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <joint_name>wheel_1_joint</joint_name>
            <joint_name>wheel_2_joint</joint_name>
            <joint_name>wheel_3_joint</joint_name>
            <joint_name>wheel_4_joint</joint_name>
            <topic>joint_states</topic>
        </plugin>
    </gazebo>

    <!-- ############################################## -->
    <!--           Differential Drive (Skid-Steer)     -->
    <!-- ############################################## -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <!-- Wheel configuration (skid-steer: 2 left, 2 right) -->
            <left_joint>wheel_1_joint</left_joint>
            <left_joint>wheel_4_joint</left_joint>
            <right_joint>wheel_2_joint</right_joint>
            <right_joint>wheel_3_joint</right_joint>

            <!-- Kinematics -->
            <wheel_separation>${box_y+cyl_l}</wheel_separation>
            <wheel_radius>${cyl_r}</wheel_radius>

            <!-- Limits -->
            <max_wheel_torque>1000</max_wheel_torque>
            <max_wheel_acceleration>5.0</max_wheel_acceleration>

            <!-- Topics -->
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>

            <!-- Frames -->
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>

            <!-- Output control -->
            <publish_odom>true</publish_odom>
            <publish_odom_tf>false</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf>
        </plugin>
    </gazebo>

</robot>
