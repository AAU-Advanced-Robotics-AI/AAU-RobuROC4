<?xml version="1.0"?>
<!--
  d435_camera.gazebo.xacro - Intel RealSense D435 Gazebo Sensor
  
  This file defines the Gazebo Harmonic RGBD camera sensor macro
  for simulating the Intel RealSense D435 depth camera.
  
  Sensor specifications (simulated):
    - Resolution: 1280x720
    - Horizontal FOV: 69.4 degrees
    - Depth range: 0.2 - 10.0 meters
    - Update rate: 30 Hz
    
  License: Apache 2.0 (derived from PAL Robotics work)
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  
    <xacro:macro name="gazebo_d435" params="camera_name reference_link topics_ns depth_optical_frame color_optical_frame infrared1_optical_frame infrared2_optical_frame publish_pointcloud:=true">

        <xacro:property name="deg_to_rad" value="0.01745329251994329577" />
        
        <gazebo reference="${reference_link}">
            <!-- Physics properties -->
            <self_collide>0</self_collide>
            <enable_wind>0</enable_wind>
            <kinematic>0</kinematic>
            <gravity>1</gravity>
            <mu2>1</mu2>
            <fdir1>0 0 0</fdir1>
            <kp>1e+13</kp>
            <kd>1</kd>
            
            <!-- 
                Gazebo Harmonic RGBD Camera sensor with GPU acceleration
                
                Gazebo camera renders looking along +X of the reference link (camera_link).
                We use the non-optical frame (camera1_color_frame) as gz_frame_id because:
                - camera_link has +X forward (ROS robot convention)
                - Gazebo renders along +X
                - This makes RViz visualization correct
                
                For RTAB-Map/vision algorithms that expect optical frame convention,
                the frame rotation is handled via the 'Reg/Force3DoF' and frame_id
                configuration in the RTAB-Map launch file.
            -->
            <sensor name="${camera_name}_rgbd" type="rgbd_camera">
                <pose>0 0 0 0 0 0</pose>
                <always_on>true</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <topic>${topics_ns}</topic>
                <gz_frame_id>${color_optical_frame}</gz_frame_id>
                <camera name="${camera_name}">
                    <horizontal_fov>${69.4*deg_to_rad}</horizontal_fov>
                    <image>
                        <width>1280</width>
                        <height>720</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>10.0</far>
                    </clip>
                    <depth_camera>
                        <clip>
                            <near>0.2</near>
                            <far>10.0</far>
                        </clip>
                    </depth_camera>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.007</stddev>
                    </noise>
                </camera>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>
