<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roburoc_sim</name>
  <version>0.0.1</version>
  <description>Simulation and SLAM launch files for RobuROC4 platform</description>
  <maintainer email="sibo@es.aau.dk">Simon Bøgh</maintainer>
  <maintainer email="es-24-rob-9-962@student.aau.dk">ROB962</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>image_transport</depend>
  <depend>camera_info_manager</depend>


  <depend>realsense2_description</depend>
  <depend>realsense2_camera</depend>
  <!-- <depend>realsense2_description</depend> -->
  <depend>vision_msgs</depend>
  <exec_depend>realsense_gazebo_plugin</exec_depend>
  <depend>velodyne_gazebo_plugins</depend>
  <depend>velodyne_description</depend>
  

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
