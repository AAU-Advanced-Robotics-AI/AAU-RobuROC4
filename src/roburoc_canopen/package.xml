  <version>0.1.0</version>
  <description>CANopen motor controller interface for RobuROC4</description>
  <maintainer email="sibo@es.aau.dk">Simon Bøgh</maintainer>
  <maintainer email="tssa20@student.aau.dk">mogens</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>python3-nest-asyncio</depend>
  <depend>canopen-pip</depend>
  <depend>python3-pydantic</depend>

  <exec_depend>roburoc_canopen_interfaces</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
